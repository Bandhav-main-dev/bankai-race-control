# =============================================================================
# HELPERS
# =============================================================================

def files_count() -> int:

    try:

        return sum(
            1
            for path in ROOT.rglob("*")
            if (
                path.is_file()
                and ".git" not in path.parts
                and "__pycache__" not in path.parts
                and "repair_backups" not in path.parts
            )
        )

    except Exception:

        return 0


def log_count() -> int:

    try:

        if not LOG_FILE.exists():
            return 0

        return len(
            LOG_FILE.read_text(
                encoding="utf-8",
                errors="ignore",
            ).splitlines()
        )

    except Exception:

        return 0


def routing() -> dict[str, Any]:

    try:

        return json.loads(
            ROUTING_FILE.read_text(
                encoding="utf-8"
            )
        )

    except Exception:

        return {}


def load_telemetry() -> dict[str, Any]:

    try:

        if not TELEMETRY_FILE.exists():
            return {}

        data = json.loads(
            TELEMETRY_FILE.read_text(
                encoding="utf-8"
            )
        )

        return data if isinstance(data, dict) else {}

    except Exception:

        return {}


def capture_telemetry(
    result: Any,
) -> dict[str, Any]:

    """
    Convert the CURRENT backend response into the
    session telemetry used by the UI.

    This does NOT perform routing.

    It only observes the result returned by the
    existing AI bridge.
    """

    telemetry = {}

    if isinstance(result, dict):

        telemetry = {
            "timestamp": result.get(
                "timestamp",
                datetime.now().isoformat(),
            ),

            "task": result.get(
                "intent",
                result.get(
                    "task",
                    "CHAT",
                ),
            ),

            "intent": result.get(
                "intent",
                "CHAT",
            ),

            "provider": result.get(
                "provider",
                "unknown",
            ),

            "tier": result.get(
                "tier",
                "unknown",
            ),

            "requested_model": result.get(
                "requested_model",
                result.get(
                    "model",
                    "unknown",
                ),
            ),

            "requested_models": result.get(
                "requested_models",
                [],
            ),

            "actual_model": result.get(
                "actual_model",
                result.get(
                    "model",
                    result.get(
                        "selected_model",
                        "unknown",
                    ),
                ),
            ),

            "selected_model": result.get(
                "selected_model",
                result.get(
                    "actual_model",
                    result.get(
                        "model",
                        "unknown",
                    ),
                ),
            ),

            "latency_seconds": result.get(
                "latency_seconds",
                result.get(
                    "elapsed",
                    0,
                ),
            ),

            "status": result.get(
                "status",
                "unknown",
            ),

            "fallback": result.get(
                "fallback",
                False,
            ),
        }

    if not telemetry:

        telemetry = load_telemetry()

    return telemetry


def refresh_telemetry():

    telemetry = load_telemetry()

    if telemetry:

        st.session_state.sf_live_telemetry = (
            telemetry
        )

    return telemetry


def ask_bankai(
    prompt: str,
    force_intent: str | None = None,
):

    """
    IMPORTANT:

    This function does NOT implement an AI provider.

    It calls the EXISTING bankai_ai_bridge.

    Therefore the current backend architecture remains
    untouched:

        UI
          ↓
        existing bridge
          ↓
        current Ruflo/OpenRouter architecture
          ↓
        model fallback
          ↓
        telemetry
    """

    try:

        from app.core.bankai_ai_bridge import (
            bankai_chat,
        )

        result = bankai_chat(
            prompt,
            conversation=(
                st.session_state.chat_messages
            ),
            force_intent=force_intent,
        )

        telemetry = capture_telemetry(
            result
        )

        if telemetry:

            st.session_state.sf_live_telemetry = (
                telemetry
            )

        return result

    except Exception as exc:

        return {
            "text": (
                "BANKAI bridge error.\n\n"
                f"`{type(exc).__name__}: {exc}`"
            ),
            "intent": "ERROR",
            "provider": "none",
            "model": "none",
            "status": "error",
        }


def result_text(
    result: Any,
) -> str:

    if isinstance(result, dict):

        return (
            result.get("text")
            or result.get("response")
            or result.get("content")
            or result.get("message")
            or "BANKAI returned no response."
        )

    return str(result)


def show_result(
    result: Any,
):

    st.markdown(
        result_text(result)
    )

    if isinstance(result, dict):

        intent = result.get(
            "intent",
            "UNKNOWN",
        )

        provider = result.get(
            "provider",
            "UNKNOWN",
        )

        model = result.get(
            "model",
            result.get(
                "actual_model",
                "UNKNOWN",
            ),
        )

        st.caption(
            "BANKAI · "
            f"{intent} · "
            f"{provider} · "
            f"{model}"
        )


# =============================================================================
# TELEMETRY UI
# =============================================================================

def render_telemetry(
    telemetry: dict[str, Any] | None = None,
):

    if not telemetry:

        telemetry = (
            st.session_state.get(
                "sf_live_telemetry",
                {},
            )
            or load_telemetry()
        )

    if not telemetry:

        st.info(
            "No routing telemetry available yet."
        )

        return

    intent = (
        telemetry.get("intent")
        or telemetry.get("task")
        or "UNKNOWN"
    )

    provider = telemetry.get(
        "provider",
        "UNKNOWN",
    )

    tier = telemetry.get(
        "tier",
        "UNKNOWN",
    )

    requested = telemetry.get(
        "requested_model",
        "UNKNOWN",
    )

    actual = (
        telemetry.get("actual_model")
        or telemetry.get("selected_model")
        or telemetry.get("model")
        or "UNKNOWN"
    )

    latency = telemetry.get(
        "latency_seconds",
        telemetry.get(
            "elapsed",
            0,
        ),
    )

    status = telemetry.get(
        "status",
        "UNKNOWN",
    )

    fallback = telemetry.get(
        "fallback",
        False,
    )

    if isinstance(latency, (int, float)):

        latency_text = (
            f"{latency:.2f}s"
        )

    else:

        latency_text = str(latency)

    fallback_text = (
        "FALLBACK ACTIVE"
        if fallback
        else "PRIMARY"
    )

    fallback_class = (
        "sf-fallback"
        if fallback
        else "sf-success"
    )

    st.markdown(
        f"""
<div class="sf-telemetry">

    <div class="sf-telemetry-title">
        📡 LIVE ROUTING TELEMETRY
    </div>

    <div class="sf-telemetry-subtitle">
        Latest real SOUL FORGE / BANKAI routing event.
    </div>

    <div class="sf-telemetry-grid">

        <div class="sf-telemetry-item">
            <div class="sf-telemetry-label">
                INTENT
            </div>
            <div class="sf-telemetry-value">
                {intent}
            </div>
        </div>

        <div class="sf-telemetry-item">
            <div class="sf-telemetry-label">
                PROVIDER
            </div>
            <div class="sf-telemetry-value">
                {provider}
            </div>
        </div>

        <div class="sf-telemetry-item">
            <div class="sf-telemetry-label">
                TIER
            </div>
            <div class="sf-telemetry-value">
                {tier}
            </div>
        </div>

        <div class="sf-telemetry-item">
            <div class="sf-telemetry-label">
                STATUS
            </div>
            <div class="sf-telemetry-value sf-success">
                {status}
            </div>
        </div>

        <div class="sf-telemetry-item">
            <div class="sf-telemetry-label">
                REQUESTED MODEL
            </div>
            <div class="sf-telemetry-value">
                {requested}
            </div>
        </div>

        <div class="sf-telemetry-item">
            <div class="sf-telemetry-label">
                ACTUAL MODEL
            </div>
            <div class="sf-telemetry-value">
                {actual}
            </div>
        </div>

        <div class="sf-telemetry-item">
            <div class="sf-telemetry-label">
                LATENCY
            </div>
            <div class="sf-telemetry-value">
                {latency_text}
            </div>
        </div>

        <div class="sf-telemetry-item">
            <div class="sf-telemetry-label">
                ROUTING
            </div>
            <div class="sf-telemetry-value {fallback_class}">
                {fallback_text}
            </div>
        </div>

    </div>

</div>
""",
        unsafe_allow_html=True,
    )


