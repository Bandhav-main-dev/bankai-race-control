                )

                if isinstance(
                    result,
                    dict,
                ):

                    if result.get(
                        "stages"
                    ):

                        with st.expander(
                            "AGENT INTERNAL ANALYSIS"
                        ):

                            stages = result[
                                "stages"
                            ]

                            st.markdown(
                                "#### PLAN"
                            )

                            st.markdown(
                                stages.get(
                                    "plan",
                                    "",
                                )
                            )

                            st.markdown(
                                "#### IMPLEMENTATION"
                            )

                            st.markdown(
                                stages.get(
                                    "implementation",
                                    "",
                                )
                            )

                            st.markdown(
                                "#### VALIDATION"
                            )

                            st.markdown(
                                stages.get(
                                    "validation",
                                    "",
                                )
                            )

                            st.markdown(
                                "#### INTERNAL REVIEW"
                            )

                            st.markdown(
                                stages.get(
                                    "review",
                                    "",
                                )
                            )

    with right:

        st.markdown(
            "### PIPELINE"
        )

        stages = [

            (
                "01",
                "UNDERSTAND",
            ),

            (
                "02",
                "PLAN",
            ),

            (
                "03",
                "IMPLEMENT",
            ),

            (
                "04",
                "VALIDATE",
            ),

            (
                "05",
                "REVIEW",
            ),

            (
                "06",
                "FINALIZE",
            ),

        ]

        for number, stage in stages:

            st.markdown(
                f"""
<div class="sf-stage">
    <span class="sf-stage-number">
        {number}
    </span>
    <strong>{stage}</strong>
</div>
""",
                unsafe_allow_html=True,
            )

        st.caption(
            "Validation and review remain internal "
            "Agentic AI responsibilities."
        )

    st.divider()

    render_telemetry()


# =============================================================================
# CODER
# =============================================================================

elif st.session_state.page == "CODER":

    st.subheader(
        "💻 BANKAI CODER"
    )

    st.caption(
        "Dedicated software implementation workspace."
    )

    request = st.text_area(
        "CODING REQUEST",
        placeholder=(
            "Describe the code you want BANKAI "
            "to create or modify..."
        ),
        height=220,
    )

    if st.button(
        "GENERATE CODE",
        use_container_width=True,
    ):

        if request.strip():

            with st.spinner(
                "BANKAI CODER..."
            ):

                result = ask_bankai(
                    request,
                    force_intent="CODING",
                )

            show_result(
                result
            )

    st.divider()

    render_telemetry()


# =============================================================================
# KNOWLEDGE
# =============================================================================

elif st.session_state.page == "KNOWLEDGE":

    st.subheader(
        "📚 BANKAI KNOWLEDGE"
    )

    st.caption(
        "Research and technical knowledge interface."
    )

    question = st.text_area(
        "QUESTION",
        placeholder=(
            "Ask BANKAI to explain or analyze something..."
        ),
        height=170,
    )

    if st.button(
        "ASK BANKAI",
        use_container_width=True,
    ):

        if question.strip():

            with st.spinner(
                "BANKAI KNOWLEDGE..."
            ):

                result = ask_bankai(
                    question,
                    force_intent="KNOWLEDGE",
                )

            show_result(
                result
            )

    st.divider()

    render_telemetry()


# =============================================================================
# MODELS
# =============================================================================

elif st.session_state.page == "MODELS":

    st.subheader(
        "🤖 MODEL CONTROL"
    )

    st.caption(
        "Current routing configuration."
    )

    data = routing()

    agents = data.get(
        "agents",
        {},
    )

    if agents:

        for name, config in agents.items():

            with st.container(
                border=True
            ):

                st.write(
                    f"**{name.upper()}**"
                )

                st.caption(
                    config.get(
                        "role",
                        "",
                    )
                )

                st.write(
                    "Provider: "
                    f"`{config.get('provider', 'unknown')}`"
                )

                st.write(
                    "Model: "
                    f"`{config.get('model', 'unknown')}`"
                )

    else:

        st.info(
            "Current model routing configuration "
            "is not available."
        )

    st.divider()

    st.markdown(
        "### AGENTIC PIPELINE"
    )

    pipeline = data.get(
        "agentic_pipeline",
        [],
    )

    if pipeline:

        st.write(
            " → ".join(pipeline)
        )

    st.divider()

    render_telemetry()


# =============================================================================
# RADIO
# =============================================================================

elif st.session_state.page == "RADIO":

    st.subheader(
        "📡 RACE RADIO"
    )

    st.caption(
        "BANKAI system telemetry and routing status."
    )

    signals = [

        (
            "SYSTEM",
            "ONLINE",
        ),

        (
            "AI BRIDGE",
            "READY",
        ),

        (
            "RUFLO",
            "ACTIVE",
        ),

        (
            "OPENROUTER",
            "ACTIVE",
        ),

        (
            "MODEL ROUTING",
            "ACTIVE",
        ),

        (
            "LIVE TELEMETRY",
            "ACTIVE",
        ),

    ]

    for name, status in signals:

        with st.container(
            border=True
        ):

            st.write(
                f"**{name}**"
            )

            st.caption(
                status
            )

    st.divider()

    render_telemetry()


# =============================================================================
# FOCUS
# =============================================================================

elif st.session_state.page == "FOCUS":

    st.subheader(
        "🎯 FOCUS MODE"
    )

    st.caption(
        "Current project mission."
    )

    st.session_state.mission = st.text_input(
        "CURRENT MISSION",
        value=st.session_state.mission,
    )

    st.progress(
        0.42
    )

    st.metric(
        "MISSION STATUS",
        "ACTIVE",
        "42%",
    )

    if st.button(
        "RESET MISSION",
        use_container_width=True,
    ):

        st.session_state.mission = (
            "SYSTEM STANDBY"
        )

        st.rerun()


# =============================================================================
# SYSTEM
# =============================================================================

elif st.session_state.page == "SYSTEM":

    st.subheader(
        "⚙ SYSTEM"
    )

    st.caption(
        "SOUL FORGE runtime integrity."
    )

    checks = [

        (
            "PROJECT",
            ROOT.exists(),
        ),

        (
            "AI BRIDGE",
            BRIDGE.exists(),
        ),

        (
            "RUFLO ENGINE",
            RUFLO.exists(),
        ),

        (
            "OPENROUTER PROVIDER",
            OPENROUTER.exists(),
        ),

        (
            "ROUTING",
            ROUTING_FILE.exists(),
        ),

        (
            "TELEMETRY",
            TELEMETRY_FILE.exists(),
        ),

        (
            "UI",
            True,
        ),

    ]

    for name, status in checks:

        if status:

            st.success(
                f"{name} · READY"
            )

        else:

            st.error(
                f"{name} · CHECK"
            )

    st.divider()

    st.write(
        "**Project:**",
        str(ROOT),
    )

    st.write(
        "**Files:**",
        files_count(),
    )

    st.write(
        "**Log events:**",
        log_count(),
    )

    st.divider()

    render_telemetry()


# =============================================================================
# GLOBAL CHAT BAR
# =============================================================================

st.divider()

st.caption(
    "BANKAI QUICK COMMAND · AVAILABLE EVERYWHERE"
)

prompt = st.chat_input(
    "Talk to BANKAI or give it a command..."
)

if prompt:

    st.session_state.chat_messages.append(
        {
            "role": "user",
            "content": prompt,
            "intent": "PENDING",
        }
    )

    with st.spinner(
        "BANKAI THINKING..."
    ):

        result = ask_bankai(
            prompt
        )

    result_intent = (
        result.get(
            "intent",
            "CHAT",
        )
        if isinstance(
            result,
            dict,
        )
        else "CHAT"
    )

    st.session_state.chat_messages[
        -1
    ].update(
        {
            "intent": result_intent
        }
    )

    st.session_state.chat_messages.append(
        {
            "role": "assistant",
            "content": result_text(
                result
            ),
            "intent": result_intent,
            "model": (
                result.get(
                    "model",
                    result.get(
                        "actual_model",
                        "",
                    ),
                )
                if isinstance(
                    result,
                    dict,
                )
                else ""
            ),
        }
    )

    st.rerun()


