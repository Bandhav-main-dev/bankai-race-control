# =============================================================================
# COMMAND CENTER
# =============================================================================

def render_command_center():

    st.subheader(
        "🏠 Command Center"
    )

    pending, completed = get_tasks()

    total = (
        len(pending)
        + len(completed)
    )

    progress = (
        len(completed) / total
        if total
        else 0.0
    )

    c1, c2, c3, c4 = st.columns(
        4,
        gap="small",
    )

    with c1:

        st.metric(
            "TASKS",
            len(pending),
        )

    with c2:

        st.metric(
            "DONE",
            len(completed),
        )

    with c3:

        st.metric(
            "PROJECT",
            project_name(),
        )

    with c4:

        st.metric(
            "PROGRESS",
            f"{progress * 100:.0f}%",
        )

    st.progress(
        progress
    )

    st.markdown(
        "### ⚡ Today's Work"
    )

    if not pending:

        st.success(
            "No pending tasks. Create your next mission below."
        )

    else:

        for task in pending[:8]:

            title = task_value(
                task,
                "title",
                "Untitled task",
            )

            priority = task_value(
                task,
                "priority",
                "NORMAL",
            )

            project = task_value(
                task,
                "project",
                project_name(),
            )

            with st.container(
                border=True
            ):

                c1, c2, c3 = st.columns(
                    [6, 1.5, 1.5],
                    gap="small",
                )

                with c1:

                    st.write(
                        f"**{title}**"
                    )

                    st.caption(
                        project
                    )

                with c2:

                    st.caption(
                        "PRIORITY"
                    )

                    st.write(
                        str(priority).upper()
                    )

                with c3:

                    task_id = task_value(
                        task,
                        "id",
                        None,
                    )

                    if st.button(
                        "✓ Done",
                        key=f"complete_{task_id}",
                        use_container_width=True,
                    ):

                        try:

                            from app.tasks.task_manager import (
                                TaskManager,
                            )

                            manager = (
                                TaskManager()
                            )

                            manager.complete(
                                task_id
                            )

                            st.rerun()

                        except Exception as exc:

                            st.error(
                                str(exc)
                            )

    st.markdown(
        "### ➕ New Task"
    )

    with st.form(
        "new_task_form",
        clear_on_submit=True,
    ):

        c1, c2, c3 = st.columns(
            [5, 2, 1.5],
            gap="small",
        )

        with c1:

            title = st.text_input(
                "Task",
                placeholder=(
                    "What needs to be done?"
                ),
                label_visibility="collapsed",
            )

        with c2:

            priority = st.selectbox(
                "Priority",
                [
                    "HIGH",
                    "MEDIUM",
                    "LOW",
                ],
                label_visibility="collapsed",
            )

        with c3:

            submit = st.form_submit_button(
                "ADD",
                use_container_width=True,
            )

        if submit and title.strip():

            try:

                from app.tasks.task_manager import (
                    TaskManager,
                )

                manager = TaskManager()

                manager.add(
                    title.strip(),
                    project_name(),
                    priority,
                )

                st.success(
                    "Task added."
                )

                st.rerun()

            except Exception as exc:

                st.error(
                    f"Task error: {exc}"
                )

    st.markdown(
        "### 🎯 Next Action"
    )

    st.warning(
        f"Current project: **{project_name()}**  •  "
        "Keep the next action small and executable."
    )

    st.divider()

    render_telemetry()


