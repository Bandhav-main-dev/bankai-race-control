    )

    if selected != current:

        st.session_state.selected_project = (
            selected
        )

        st.rerun()

    c1, c2, c3 = st.columns(
        3,
        gap="small",
    )

    with c1:

        st.metric(
            "PROJECT",
            selected,
        )

    with c2:

        st.metric(
            "MODE",
            "DEVELOPMENT",
        )

    with c3:

        st.metric(
            "FILES",
            project_files(),
        )

    st.markdown(
        "### 🔍 Project Signals"
    )

    signals = [

        (
            "Repository",
            "Connected locally",
        ),

        (
            "AI Architecture",
            "RUFLO + OPENROUTER",
        ),

        (
            "Model Routing",
            "MULTI-MODEL FALLBACK",
        ),

        (
            "Telemetry",
            "LIVE",
        ),

    ]

    for label, value in signals:

        with st.container(
            border=True
        ):

            c1, c2 = st.columns(
                [2, 5],
                gap="small",
            )

            with c1:

                st.caption(
                    label
                )

            with c2:

                st.write(
                    value
                )

    st.info(
        "SOUL FORGE backend routing is preserved. "
        "UI changes do not replace RUFLO or OpenRouter."
    )


# =============================================================================
# KNOWLEDGE
# =============================================================================

def render_knowledge():

    st.subheader(
        "📚 Knowledge"
    )

    st.caption(
        "Source-grounded development workspace."
    )

    try:

        from app.knowledge.knowledge_engine import (
            KnowledgeEngine,
        )

        engine = KnowledgeEngine()

    except Exception:

        st.warning(
            "Knowledge engine is not currently available."
        )

        return

    uploaded = st.file_uploader(
        "Upload source",
        type=[
            "txt",
            "md",
            "csv",
        ],
    )

    if uploaded is not None:

        try:

            content = uploaded.read().decode(
                "utf-8",
                errors="replace",
            )

            engine.add_text(
                uploaded.name,
                content,
            )

            st.success(
                f"Source loaded: {uploaded.name}"
            )

        except Exception as exc:

            st.error(
                f"Source error: {exc}"
            )

    question = st.text_area(
        "Knowledge Question",
        placeholder=(
            "Ask something about your sources..."
        ),
        height=100,
    )

    if st.button(
        "🧠 SEARCH KNOWLEDGE",
        use_container_width=True,
    ):

        if not question.strip():

            st.warning(
                "Enter a question first."
            )

        else:

            try:

                result = engine.retrieve(
                    question.strip()
                )

                st.subheader(
                    "📖 Retrieved Context"
                )

                st.write(
                    result
                )

            except Exception as exc:

                st.error(
                    f"Retrieval error: {exc}"
                )


# =============================================================================
# CHAT
# =============================================================================

def render_chat():

    st.subheader(
        "💬 SOUL FORGE Chat"
    )

    st.caption(
        "Normal conversation through the production "
        "BANKAI AI bridge."
    )

    for message in (
        st.session_state.chat_messages
    ):

        role = message.get(
            "role",
            "user",
        )

        with st.chat_message(
            role
        ):

            st.write(
                message.get(
                    "content",
                    "",
                )
            )

            model = message.get(
                "model"
            )

            if model:

                st.caption(
                    f"MODEL · {model}"
                )

    prompt = st.chat_input(
        "Ask SOUL FORGE..."
    )

    if prompt:

        st.session_state.chat_messages.append(
            {
                "role": "user",
                "content": prompt,
            }
        )

        with st.chat_message(
            "user"
        ):

            st.write(
                prompt
            )

        with st.chat_message(
            "assistant"
        ):

            with st.spinner(
                "BANKAI THINKING..."
            ):

                result = bankai_request(
                    prompt,
                    intent="CHAT",
                )

            response = result_text(
                result
            )

            st.write(
                response
            )

            if isinstance(
                result,
                dict,
            ):

                model = result.get(
                    "actual_model",
                    result.get(
                        "model",
                        "",
                    ),
                )

                if model:

                    st.caption(
                        f"MODEL · {model}"
                    )

                st.session_state.chat_messages.append(
                    {
                        "role": "assistant",
                        "content": response,
                        "model": model,
                    }
                )

            else:

                st.session_state.chat_messages.append(
                    {
                        "role": "assistant",
                        "content": response,
                    }
                )

        st.rerun()

    st.divider()

    render_telemetry()


# =============================================================================
# AGENTIC AI
# =============================================================================

def render_agentic():

    st.subheader(
        "🤖 Agentic AI"
    )

    st.caption(
        "UNDERSTAND → PLAN → IMPLEMENT → "
        "VALIDATE → REVIEW → FINALIZE"
    )

    st.markdown(
        "### 🧠 Mission"
    )

    prompt = st.text_area(
        "Agentic request",
        value=(
            st.session_state.agentic_prompt
        ),
        placeholder=(
            "Example: Build a complete Python module for..."
        ),
        height=120,
    )

    st.session_state.agentic_prompt = (
        prompt
    )

    if st.button(
        "🚀 START AGENTIC WORKFLOW",
        use_container_width=True,
    ):

        if not prompt.strip():

            st.warning(
                "Enter an agentic request first."
            )

        else:

            with st.status(
                "RUFLO agentic workflow running...",
                expanded=True,
            ) as status:

                st.write(
                    "🧠 UNDERSTAND"
                )

                st.write(
                    "📋 PLAN"
                )

                st.write(
                    "⚙️ IMPLEMENT"
                )

                st.write(
                    "🧪 VALIDATE"
                )

                st.write(
                    "🔎 REVIEW"
                )

                st.write(
                    "🏁 FINALIZE"
                )

                result = bankai_request(
                    prompt.strip(),
                    intent="AGENTIC",
                )

                st.session_state.agentic_result = (
                    result
                )

                status.update(
                    label=(
                        "Agentic workflow complete"
                    ),
                    state="complete",
                )

    result = (
        st.session_state.agentic_result
    )

    if result is not None:

        st.markdown(
            "### 🧩 Result"
        )

        show_result(
            result
        )

        if isinstance(
            result,
            dict,
        ):

            stages = result.get(
                "stages"
            )

            if isinstance(
                stages,
                dict,
            ):

                st.markdown(
                    "### 🔬 Agentic Stages"
                )

                stage_names = [

                    (
                        "UNDERSTAND",
                        "understanding",
                    ),

                    (
                        "PLAN",
                        "plan",
                    ),

                    (
                        "IMPLEMENT",
                        "implementation",
                    ),

                    (
                        "VALIDATE",
                        "validation",
                    ),

                    (
                        "REVIEW",
                        "review",
                    ),

                    (
                        "FINALIZE",
                        "finalize",
                    ),

                ]

                for title, key in stage_names:

                    content = stages.get(
                        key,
                        "",
                    )

                    with st.expander(
                        f"{'✓' if content else '○'} {title}",
                        expanded=False,
                    ):

                        if content:

                            st.write(
                                content
                            )

                        else:

                            st.caption(
                                "Stage information unavailable."
                            )

    st.markdown(
        "### 👨‍💻 User Control"
    )

    st.warning(
        "Generated work remains under user control. "
        "Review and test before acceptance."
    )

    c1, c2 = st.columns(
        2,
        gap="small",
    )

    with c1:

        if st.button(
            "🧪 USER TEST",
            use_container_width=True,
        ):

            st.session_state.agentic_user_tested = (
                True
            )

            st.success(
                "Marked for user testing."
            )

    with c2:

        if st.button(
            "✓ ACCEPT",
            use_container_width=True,
        ):

            st.session_state.agentic_accepted = (
                True
            )

            st.success(
                "User acceptance recorded."
            )

    st.divider()

    render_telemetry()


# =============================================================================
# PITMYDORO
# =============================================================================

def render_pitmydoro():

    st.subheader(
        "⏱️ PITMYDORO"
    )

    st.caption(
        "Coding focus • task linked • F1 race mindset."
    )

    if st.session_state.pit_running:

        if (
            st.session_state.pit_started_at
            is None
        ):

            st.session_state.pit_started_at = (
                time.time()
            )

        elapsed = (
            st.session_state.pit_elapsed
            + (
                time.time()
                - st.session_state.pit_started_at
            )
        )

    else:

        elapsed = (
            st.session_state.pit_elapsed
        )

    timer_col, status_col = st.columns(
        [2.5, 1],
        gap="small",
    )

    with timer_col:

        st.metric(
            "LAP",
            f"{st.session_state.pit_lap:02d}",
        )

        st.metric(
            "TIME",
            format_seconds(elapsed),
        )

    with status_col:

        if st.session_state.pit_running:

            st.success(
                "RACING"
            )

        else:

            st.info(
                "STANDBY"
            )

        st.caption(
            f"PROJECT: {project_name()}"
        )

    if st.session_state.pit_running:

        st.markdown(
            "### 🔴 🔴 🔴 🔴 🔴"
        )

        st.caption(
            "FULL FOCUS • STAY ON THE LAP"
        )

    else:

        st.markdown(
            "### ⚫ ⚫ ⚫ ⚫ ⚫"
        )

        st.caption(
            "READY TO START"
        )

    c1, c2, c3 = st.columns(
        3,
        gap="small",
    )

    with c1:

        if not st.session_state.pit_running:

            if st.button(
                "🏁 START",
                use_container_width=True,
            ):

                st.session_state.pit_running = (
                    True
                )

                st.session_state.pit_started_at = (
                    time.time()
                )

                st.rerun()

        else:

            if st.button(
                "⏸ PAUSE",
                use_container_width=True,
            ):

                st.session_state.pit_elapsed = (
                    elapsed
                )

                st.session_state.pit_running = (
                    False
                )

                st.session_state.pit_started_at = (
                    None
                )

                st.rerun()

    with c2:

        if st.button(
            "🔄 RESET",
            use_container_width=True,
        ):

            st.session_state.pit_running = (
                False
            )

            st.session_state.pit_started_at = (
                None
            )

            st.session_state.pit_elapsed = (
                0.0
            )

            st.session_state.pit_lap = 1

            st.rerun()

    with c3:

        if st.button(
            "🏎️ NEXT LAP",
            use_container_width=True,
        ):

            st.session_state.pit_lap += 1

            st.session_state.pit_elapsed = (
                0.0
            )

            st.session_state.pit_started_at = (

                time.time()

                if st.session_state.pit_running

                else None

            )

            st.rerun()

    if st.session_state.pit_running:

        @st.fragment(
            run_every="1s"
        )
        def live_timer():

            if (
                st.session_state.pit_started_at
                is None
            ):

                return

            current = (
                st.session_state.pit_elapsed
                + (
                    time.time()
                    - st.session_state.pit_started_at
                )
            )

            st.metric(
                "LIVE",
                format_seconds(current),
            )

        live_timer()

    st.markdown(
        "### 📻 DRIVER MINDSET"
    )

    st.info(
        "Focus on the current lap. "
        "One task. One decision. One improvement."
    )


# =============================================================================
# PAGE ROUTER
# =============================================================================

if (
    st.session_state.page
    == "Command Center"
):

    render_command_center()

elif (
    st.session_state.page
    == "Projects"
):

    render_projects()

elif (
    st.session_state.page
    == "Knowledge"
):

    render_knowledge()

elif (
    st.session_state.page
    == "Chat"
):

    render_chat()

elif (
    st.session_state.page
    == "Agentic AI"
):

    render_agentic()

elif (
    st.session_state.page
    == "PITMYDORO"
):

    render_pitmydoro()


# =============================================================================
# BOTTOM STATUS BAR
# =============================================================================

st.divider()

c1, c2, c3 = st.columns(
    [2, 5, 2],
    gap="small",
)

with c1:

    st.caption(
        "⚔️ SOUL FORGE"
    )

with c2:

    st.caption(
        f"PROJECT • {project_name()}"
    )

with c3:

    st.caption(
        datetime.now().strftime(
            "%H:%M"
        )
    )
