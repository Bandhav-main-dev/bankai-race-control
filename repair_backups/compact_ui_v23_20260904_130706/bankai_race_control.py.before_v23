# =============================================================================
# BACKEND
# =============================================================================

def bankai_request(
    prompt,
    intent=None,
):
    """
    IMPORTANT:

    The UI does not directly instantiate Ollama,
    Ruflo, or OpenRouter.

    It calls the existing production AI bridge.

    Current architecture:

        UI
          ↓
        bankai_ai_bridge
          ↓
        RUFLO
          ↓
        OPENROUTER
          ↓
        MODEL FALLBACK
          ↓
        TELEMETRY
    """

    try:

        from app.core.bankai_ai_bridge import (
            bankai_chat,
        )

        kwargs = {}

        if intent:

            kwargs["force_intent"] = intent

        result = bankai_chat(
            prompt,
            **kwargs,
        )

        telemetry = {}

        if isinstance(result, dict):

            telemetry = {

                "timestamp":
                    result.get(
                        "timestamp",
                        datetime.now().isoformat(),
                    ),

                "intent":
                    result.get(
                        "intent",
                        intent or "CHAT",
                    ),

                "task":
                    result.get(
                        "task",
                        result.get(
                            "intent",
                            intent or "CHAT",
                        ),
                    ),

                "provider":
                    result.get(
                        "provider",
                        "unknown",
                    ),

                "tier":
                    result.get(
                        "tier",
                        "unknown",
                    ),

                "requested_model":
                    result.get(
                        "requested_model",
                        "unknown",
                    ),

                "requested_models":
                    result.get(
                        "requested_models",
                        [],
                    ),

                "actual_model":
                    result.get(
                        "actual_model",
                        result.get(
                            "selected_model",
                            result.get(
                                "model",
                                "unknown",
                            ),
                        ),
                    ),

                "selected_model":
                    result.get(
                        "selected_model",
                        result.get(
                            "actual_model",
                            result.get(
                                "model",
                                "unknown",
                            ),
                        ),
                    ),

                "latency_seconds":
                    result.get(
                        "latency_seconds",
                        result.get(
                            "elapsed",
                            0,
                        ),
                    ),

                "status":
                    result.get(
                        "status",
                        "unknown",
                    ),

                "fallback":
                    result.get(
                        "fallback",
                        False,
                    ),

            }

            st.session_state.sf_live_telemetry = (
                telemetry
            )

        return result

    except Exception as exc:

        return {

            "text":
                (
                    "BANKAI AI BRIDGE ERROR\n\n"
                    f"{type(exc).__name__}: {exc}"
                ),

            "intent":
                intent or "ERROR",

            "provider":
                "none",

            "model":
                "none",

            "status":
                "error",

        }


# =============================================================================
# RESULT
# =============================================================================

def result_text(result):

    if isinstance(result, dict):

        return (
            result.get("text")
            or result.get("response")
            or result.get("content")
            or result.get("message")
            or "BANKAI returned no response."
        )

    return str(result)


def show_result(result):

    st.write(
        result_text(result)
    )

    if isinstance(result, dict):

        intent = result.get(
            "intent",
            "UNKNOWN",
        )

        provider = result.get(
            "provider",
            "UNKNOWN",
        )

        model = result.get(
            "actual_model",
            result.get(
                "selected_model",
                result.get(
                    "model",
                    "UNKNOWN",
                ),
            ),
        )

        st.caption(
            f"ROUTED · {intent} · "
            f"{provider} · {model}"
        )


# =============================================================================
# TELEMETRY
# =============================================================================

def load_telemetry():

    try:

        if not TELEMETRY_FILE.exists():

            return {}

        data = json.loads(
            TELEMETRY_FILE.read_text(
                encoding="utf-8"
            )
        )

        return (
            data
            if isinstance(data, dict)
            else {}
        )

    except Exception:

        return {}


def refresh_telemetry():

    telemetry = load_telemetry()

    if telemetry:

        st.session_state.sf_live_telemetry = (
            telemetry
        )

    return telemetry


def render_telemetry():

    telemetry = (
        st.session_state.get(
            "sf_live_telemetry",
            {},
        )
        or load_telemetry()
    )

    st.subheader(
        "📡 LIVE ROUTING TELEMETRY"
    )

    st.caption(
        "Real-time RUFLO + OpenRouter routing information."
    )

    if not telemetry:

        st.info(
            "No routing telemetry available yet."
        )

        return

    intent = (
        telemetry.get("intent")
        or telemetry.get("task")
        or "UNKNOWN"
    )

    provider = telemetry.get(
        "provider",
        "UNKNOWN",
    )

    tier = telemetry.get(
        "tier",
        "UNKNOWN",
    )

    status = telemetry.get(
        "status",
        "UNKNOWN",
    )

    requested_model = telemetry.get(
        "requested_model",
        "UNKNOWN",
    )

    actual_model = (
        telemetry.get("actual_model")
        or telemetry.get("selected_model")
        or telemetry.get("model")
        or "UNKNOWN"
    )

    latency = telemetry.get(
        "latency_seconds",
        telemetry.get(
            "elapsed",
            0,
        ),
    )

    fallback = telemetry.get(
        "fallback",
        False,
    )

    if isinstance(
        latency,
        (int, float),
    ):

        latency_display = (
            f"{latency:.2f}s"
        )

    else:

        latency_display = str(latency)

    routing = (
        "FALLBACK"
        if fallback
        else "PRIMARY"
    )

    c1, c2, c3, c4 = st.columns(
        4,
        gap="small",
    )

    with c1:

        st.metric(
            "INTENT",
            str(intent),
        )

    with c2:

        st.metric(
            "PROVIDER",
            str(provider),
        )

    with c3:

        st.metric(
            "TIER",
            str(tier),
        )

    with c4:

        st.metric(
            "STATUS",
            str(status),
        )

    c1, c2, c3, c4 = st.columns(
        4,
        gap="small",
    )

    with c1:

        st.metric(
            "REQUESTED MODEL",
            str(requested_model),
        )

    with c2:

        st.metric(
            "ACTUAL MODEL",
            str(actual_model),
        )

    with c3:

        st.metric(
            "LATENCY",
            latency_display,
        )

    with c4:

        st.metric(
            "ROUTING",
            routing,
        )

    requested_models = telemetry.get(
        "requested_models",
        [],
    )

    if requested_models:

        with st.expander(
            "MODEL FALLBACK CHAIN",
            expanded=False,
        ):

            for index, model in enumerate(
                requested_models,
                start=1,
            ):

                st.write(
                    f"{index}. `{model}`"
                )

    timestamp = telemetry.get(
        "timestamp"
    )

    if timestamp:

        st.caption(
            f"Last telemetry event: {timestamp}"
        )


# =============================================================================
# PROJECT / TASK HELPERS
# =============================================================================

def get_tasks():

    try:

        from app.tasks.task_manager import (
            TaskManager,
        )

        manager = TaskManager()

        pending = manager.pending()
        completed = manager.completed()

        return (
            pending or [],
            completed or [],
        )

    except Exception:

        return [], []


def project_name():

    return st.session_state.get(
        "selected_project",
        "BANKAI-RACE-CONTROL",
    )


def task_value(
    task,
    key,
    default="",
):

    if isinstance(task, dict):

        return task.get(
            key,
            default,
        )

    return getattr(
        task,
        key,
        default,
    )


def format_seconds(seconds):

    seconds = max(
        0,
        int(seconds),
    )

    minutes = seconds // 60

    secs = seconds % 60

    return (
        f"{minutes:02d}:{secs:02d}"
    )


def project_files():

    try:

        return sum(

            1

            for path in PROJECT_ROOT.rglob("*")

            if (
                path.is_file()
                and ".git" not in path.parts
                and "__pycache__" not in path.parts
                and "repair_backups" not in path.parts
            )

        )

    except Exception:

        return 0


def log_events():

    try:

        if not LOG_FILE.exists():

            return 0

        return len(
            LOG_FILE.read_text(
                encoding="utf-8",
                errors="ignore",
            ).splitlines()
        )

    except Exception:

        return 0


