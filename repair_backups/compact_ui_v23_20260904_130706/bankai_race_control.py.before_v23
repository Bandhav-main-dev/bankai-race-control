def render_projects():

    st.subheader(
        "📁 Projects"
    )

    st.caption(
        "Your development workspace."
    )

    projects = [

        "BANKAI-RACE-CONTROL",

        "Einstain-ai-brain-v2",

    ]

    current = project_name()

    selected = st.selectbox(
        "Current Project",
        projects,
        index=(
            projects.index(current)
            if current in projects
