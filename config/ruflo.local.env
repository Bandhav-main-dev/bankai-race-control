# =============================================================================
# BANKAI RACE CONTROL — RUFLO LOCAL AI CONFIGURATION
# =============================================================================

# Local Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:latest

# Ruflo
BANKAI_RUFLO_ENABLED=true
BANKAI_RUFLO_ROUTING=adaptive

# Context handoff
BANKAI_CONTEXT_HANDOFF=true
BANKAI_TOKEN_THRESHOLD=85

# Optional cloud providers
# Add these ONLY when you want cloud models.
#
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# BANKAI local-first mode
BANKAI_LOCAL_FIRST=true
