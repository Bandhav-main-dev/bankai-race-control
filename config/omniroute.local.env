# ============================================================================
# BANKAI RACE CONTROL
# OmniRoute Local Provider Configuration
# ============================================================================

PORT=20128

# Local/private providers
OMNIROUTE_ALLOW_PRIVATE_PROVIDER_URLS=true
OMNIROUTE_ALLOW_LOCAL_PROVIDER_URLS=true

# Ollama
LLM_PROVIDER=openai_compatible
LLM_API_KEY=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3:latest

# BANKAI local mode
BANKAI_LOCAL_ONLY=true
BANKAI_OMNIROUTE_URL=http://127.0.0.1:20128/v1
BANKAI_OMNIROUTE_KEY=bankai-local
BANKAI_MODEL=qwen3:latest
