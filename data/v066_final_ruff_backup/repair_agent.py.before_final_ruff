"""
BANKAI RACE CONTROL — V0.6.6 Repair Agent.

Converts validation failures into a structured repair plan.

V0.6.6 intentionally does not claim autonomous source-code mutation.
The repair agent prepares deterministic repair instructions that can be
consumed by the existing CodingAgent.
"""

from __future__ import annotations

from dataclasses import dataclass, field
from datetime import datetime, timezone
import uuid
from typing import Any


@dataclass
class RepairResult:
    """Structured result produced by the RepairAgent."""

    repair_id: str
    mission_id: str
    attempt: int
    status: str
    failure_summary: list[str] = field(default_factory=list)
    failed_checks: list[str] = field(default_factory=list)
    repair_steps: list[str] = field(default_factory=list)
    files_to_modify: list[str] = field(default_factory=list)
    validation_steps: list[str] = field(default_factory=list)
    notes: str = ""
    created_at: str = field(
        default_factory=lambda: datetime.now(
            timezone.utc
        ).isoformat()
    )

    def to_dict(self) -> dict[str, Any]:
        """Convert the repair result to a serializable dictionary."""
        return {
            "repair_id": self.repair_id,
            "mission_id": self.mission_id,
            "attempt": self.attempt,
            "status": self.status,
            "failure_summary": list(self.failure_summary),
            "failed_checks": list(self.failed_checks),
            "repair_steps": list(self.repair_steps),
            "files_to_modify": list(self.files_to_modify),
            "validation_steps": list(self.validation_steps),
            "notes": self.notes,
            "created_at": self.created_at,
        }

    @classmethod
    def from_dict(
        cls,
        data: dict[str, Any],
    ) -> RepairResult:
        """Restore a RepairResult from persisted state."""
        return cls(
            repair_id=str(
                data.get("repair_id", "")
            ),
            mission_id=str(
                data.get("mission_id", "")
            ),
            attempt=int(
                data.get("attempt", 1)
            ),
            status=str(
                data.get("status", "prepared")
            ),
            failure_summary=list(
                data.get("failure_summary", [])
            ),
            failed_checks=list(
                data.get("failed_checks", [])
            ),
            repair_steps=list(
                data.get("repair_steps", [])
            ),
            files_to_modify=list(
                data.get("files_to_modify", [])
            ),
            validation_steps=list(
                data.get("validation_steps", [])
            ),
            notes=str(
                data.get("notes", "")
            ),
            created_at=str(
                data.get("created_at", "")
            ),
        )


class RepairAgent:
    """Create deterministic repair plans from validation failures."""

    def __init__(
        self,
        max_attempts: int = 3,
    ) -> None:
        if max_attempts < 1:
            raise ValueError(
                "max_attempts must be >= 1"
            )

        self.max_attempts = int(
            max_attempts
        )

    @staticmethod
    def _get(
        value: Any,
        name: str,
        default: Any = None,
    ) -> Any:
        """Read an attribute or dictionary key safely."""
        if isinstance(value, dict):
            return value.get(
                name,
                default,
            )

        return getattr(
            value,
            name,
            default,
        )

    def can_repair(
        self,
        attempt: int,
    ) -> bool:
        """Return whether another repair attempt is allowed."""
        return int(attempt) <= self.max_attempts

    def create_repair(
        self,
        mission_id: str,
        validation_result: Any,
        attempt: int = 1,
    ) -> RepairResult:
        """Create a structured repair result."""
        attempt = int(attempt)

        if not self.can_repair(attempt):
            return RepairResult(
                repair_id=f"repair-{uuid.uuid4().hex[:12]}",
                mission_id=str(mission_id),
                attempt=attempt,
                status="max_attempts_exceeded",
                failure_summary=[
                    "Maximum repair attempts exceeded."
                ],
                failed_checks=[],
                repair_steps=[],
                files_to_modify=[],
                validation_steps=[],
                notes=(
                    f"Maximum allowed attempts: "
                    f"{self.max_attempts}"
                ),
            )

        checks = self._get(
            validation_result,
            "checks",
            [],
        )

        errors = self._get(
            validation_result,
            "errors",
            [],
        )

        failed_checks: list[str] = []
        failure_summary: list[str] = []

        if isinstance(checks, dict):
            check_items = checks.items()
        else:
            check_items = []

            for check in checks or []:
                name = self._get(
                    check,
                    "name",
                    "unknown",
                )

                passed = self._get(
                    check,
                    "passed",
                    False,
                )

                message = self._get(
                    check,
                    "message",
                    "",
                )

                if not passed:
                    failed_checks.append(
                        str(name)
                    )

                    failure_summary.append(
                        str(message or name)
                    )

        for name, check in check_items:
            passed = self._get(
                check,
                "passed",
                False,
            )

            if not passed:
                failed_checks.append(
                    str(name)
                )

                message = self._get(
                    check,
                    "message",
                    "",
                )

                failure_summary.append(
                    str(message or name)
                )

        for error in errors or []:
            text = str(error)

            if text and text not in failure_summary:
                failure_summary.append(text)

        if not failure_summary:
            failure_summary.append(
                "Automatic validation failed."
            )

        repair_steps = [
            "Inspect each failed validation check.",
            "Identify the smallest safe change required.",
            "Preserve existing V0.6.1–V0.6.5 interfaces.",
            "Apply the repair through the CodingAgent.",
            "Re-run automatic validation.",
        ]

        validation_steps = [
            "Python syntax validation",
            "BANKAI import validation",
            "Targeted Ruff validation",
            "Pytest regression validation",
        ]

        return RepairResult(
            repair_id=f"repair-{uuid.uuid4().hex[:12]}",
            mission_id=str(mission_id),
            attempt=attempt,
            status="repairing",
            failure_summary=failure_summary,
            failed_checks=failed_checks,
            repair_steps=repair_steps,
            files_to_modify=[],
            validation_steps=validation_steps,
            notes=(
                "V0.6.6 structured repair plan. "
                "Autonomous source mutation is not claimed."
            ),
        )

    def create_plan(
        self,
        mission_id: str,
        validation_result: Any,
        attempt: int = 1,
    ) -> RepairResult:
        """Compatibility alias for create_repair."""
        return self.create_repair(
            mission_id=mission_id,
            validation_result=validation_result,
            attempt=attempt,
        )
